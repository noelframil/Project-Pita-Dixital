# ═══════════════════════════════════════════════════════════════
# Staging: infraestructura local en Docker + proveedores reales
# ═══════════════════════════════════════════════════════════════
#
#   cp .env.staging.example .env
#
# Se copia a `.env` y no se usa directamente: `config.ts` carga `.env` vía
# dotenv, sin soporte para perfiles. Un fichero por perfil que luego se copia es
# más simple que añadir una capa de resolución de entornos que nadie más usa.
#
# NUNCA versiones el `.env` resultante: lleva claves reales. El `.gitignore` ya
# lo cubre, pero conviene saberlo.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Infraestructura local (docker-compose.yml de la raíz) ─────
#
# Ojo con los puertos: NO son los estándar, a propósito, para no chocar con un
# Postgres o un Redis que ya tengas instalado en la máquina.
DATABASE_URL=postgresql://pita:pita_local_dev@localhost:5433/pita
REDIS_URL=redis://localhost:6380

# ── Secretos del propio servicio ──────────────────────────────
#
# Genera las dos con:  openssl rand -base64 32
# ENCRYPTION_KEY debe ser exactamente 32 bytes en base64 o el arranque muere.
ENCRYPTION_KEY=
API_KEY_PEPPER=

# ── Proveedores de modelo ─────────────────────────────────────
#
# En staging conviene tener las dos: el bot puede correr con Anthropic mientras
# los embeddings, Whisper y la visión salen de OpenAI.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Ollama sigue disponible para probar sin gastar. Si no lo tienes levantado,
# déjalo: solo se usa cuando un bot_config lo pide como proveedor.
OLLAMA_HOST=http://127.0.0.1:11434

# ── Canales ───────────────────────────────────────────────────
#
# El token de cada bot de Telegram NO va aquí: va cifrado en channel_accounts.
#   npm run admin -- link-telegram <slug> <token>
# TELEGRAM_WEBHOOK_SECRET=

# URL pública, cuando corras con túnel. La imprime `npm run tunnel`.
# PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# ── Autoconfiguración ─────────────────────────────────────────
AUTOCONFIG_PROVIDER=anthropic
AUTOCONFIG_MODEL=claude-opus-5
AUTOCONFIG_MAX_TOKENS=8000
AUTOCONFIG_TIMEOUT_MS=180000

# ── RAG vectorial ─────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=30000

# ── Multimodal ────────────────────────────────────────────────
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=es
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o
VISION_MAX_TOKENS=700
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_ATTACHMENTS=4
MEDIA_TIMEOUT_MS=60000

# ── Herramientas ──────────────────────────────────────────────
TOOL_TIMEOUT_MS=10000
TOOL_MAX_RESPONSE_CHARS=4000

# ── Memoria de conversación ───────────────────────────────────
MEMORY_SUMMARY_MAX_TOKENS=400

# ── Handoff ───────────────────────────────────────────────────
HANDOFF_WEBHOOK_TIMEOUT_MS=10000
HANDOFF_MAX_ATTEMPTS=6
HANDOFF_POLL_MS=15000

# ── Trazas del agente (LLMOps) ────────────────────────────────
#
# En staging interesan encendidas: son lo que explica por qué el bot contestó
# lo que contestó. Para depurar con `npm run chat` sin ensuciar la tabla,
# ponlo a false — el CLI recibe las trazas igual, por el observador en proceso.
TRACE_ENABLED=true
TRACE_MAX_PAYLOAD_CHARS=4000

# ── Mensajes proactivos ───────────────────────────────────────
PROACTIVE_CONCURRENCY=2
PROACTIVE_RATE_MAX=30
PROACTIVE_MAX_ATTEMPTS=4
PROACTIVE_MAX_TOKENS=300
# En staging conviene bajarlo para poder probar dos proactivos seguidos sin
# esperar seis horas. En producción, déjalo alto.
PROACTIVE_MIN_GAP_MS=60000
PROACTIVE_MAX_DELAY_MS=2592000000

# ── Autocrítica ───────────────────────────────────────────────
#
# Se activa por cliente (bot_configs.reflection_enabled), no aquí:
#   npm run admin -- set-feature <slug> autocritica on
REFLECTION_MAX_TOKENS=300
REFLECTION_TIMEOUT_MS=20000
REFLECTION_MAX_PROMPT_CHARS=6000

# ── Límites ───────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
LLM_TIMEOUT_MS=120000
MAX_MESSAGE_CHARS=4000

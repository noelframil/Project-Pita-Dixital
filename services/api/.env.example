# ── Núcleo ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://pita:pita_local_dev@localhost:5433/pita

# Genera las dos con:  openssl rand -base64 32
ENCRYPTION_KEY=
API_KEY_PEPPER=

# ── Modelos ───────────────────────────────────────────────────
# Ollama corre en local: sin coste y sin salir de tu máquina.
OLLAMA_HOST=http://127.0.0.1:11434
# Opcionales, para producción:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Autoconfiguración (fase 1) ────────────────────────────────
# Se ejecuta una vez por cliente, desde la CLI. De la calidad de esa pasada
# depende todo lo que ese bot dirá después: aquí compensa el modelo bueno.
# Para probar sin gastar:  npm run admin -- autoconfig <slug> "..." --provider ollama
AUTOCONFIG_PROVIDER=anthropic
AUTOCONFIG_MODEL=claude-opus-5
# El razonamiento y la respuesta comparten este presupuesto. Si se queda corto,
# la salida llega truncada o vacía.
AUTOCONFIG_MAX_TOKENS=8000
AUTOCONFIG_TIMEOUT_MS=180000

# ── Herramientas (fase 3) ─────────────────────────────────────
# Ejecutan peticiones a terceros con parámetros que elige el modelo. Todo
# acotado: destino fijo, sin redirecciones, sin direcciones internas.
TOOL_TIMEOUT_MS=10000
TOOL_MAX_RESPONSE_CHARS=4000

# ── Memoria (fase 4) ──────────────────────────────────────────
# Techo del resumen acumulado por conversación. El presupuesto de contexto va
# por cliente, en bot_configs.context_token_budget.
MEMORY_SUMMARY_MAX_TOKENS=400

# ── RAG vectorial ─────────────────────────────────────────────
# Los embeddings son de OpenAI aunque el bot conteste con otro proveedor:
# la dimensión está atada al tipo de la columna en Postgres (vector(1536)),
# así que cambiar de modelo es una migración, no un ajuste de configuración.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=30000

# ── Multimodal (voz e imagen) ─────────────────────────────────
WHISPER_MODEL=whisper-1
# Fijar el idioma sube bastante la precisión: una nota corta en gallego se
# transcribe como portugués si se deja que lo adivine.
WHISPER_LANGUAGE=es
VISION_PROVIDER=openai       # openai | anthropic
VISION_MODEL=gpt-4o
VISION_MAX_TOKENS=700
MEDIA_MAX_BYTES=10485760     # 10 MB
MEDIA_MAX_ATTACHMENTS=4
MEDIA_TIMEOUT_MS=60000

# ── Handoff a humano ──────────────────────────────────────────
# La URL y el secreto van por cliente, en la tabla clients:
#   npm run admin -- set-handoff <slug> https://...
HANDOFF_WEBHOOK_TIMEOUT_MS=10000
HANDOFF_MAX_ATTEMPTS=6
HANDOFF_POLL_MS=15000

# ── Trazabilidad del agente (LLMOps) ──────────────────────────
# Registra cada paso del razonamiento en agent_traces. Las escrituras no
# esperan y sus fallos nunca rompen el turno.
TRACE_ENABLED=true
TRACE_MAX_PAYLOAD_CHARS=4000

# ── Cola de mensajes proactivos (BullMQ) ──────────────────────
# OPCIONAL. Sin REDIS_URL esta capa se apaga y el resto arranca igual: el flujo
# de desarrollo por defecto (docker compose = solo Postgres) sigue funcionando.
# Para activarla:  docker compose up -d redis
# REDIS_URL=redis://localhost:6380
PROACTIVE_CONCURRENCY=2
PROACTIVE_RATE_MAX=30          # por minuto; no agotar el rate limit del proveedor
PROACTIVE_MAX_ATTEMPTS=4
PROACTIVE_MAX_TOKENS=300
PROACTIVE_MIN_GAP_MS=21600000  # 6 h de descanso entre proactivos al mismo contacto
PROACTIVE_MAX_DELAY_MS=2592000000  # 30 días de programación máxima

# ── Límites ───────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
LLM_TIMEOUT_MS=120000  # Ollama en frío tarda >60s en cargar un modelo de 32B
MAX_MESSAGE_CHARS=4000

# Los tokens de cada cliente (bot de Telegram, número de WhatsApp, página de
# Instagram) NO van aquí: van cifrados en la tabla channel_accounts.
# Enlázalos con:  npm run admin -- link-telegram <slug> <token>

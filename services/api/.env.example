# ── Núcleo ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://pita:pita_local_dev@localhost:5433/pita

# Genera las dos con:  openssl rand -base64 32
ENCRYPTION_KEY=
API_KEY_PEPPER=

# ── Modelos ───────────────────────────────────────────────────
# Ollama corre en local: sin coste y sin salir de tu máquina.
OLLAMA_HOST=http://127.0.0.1:11434
# Opcionales, para producción:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Autoconfiguración (fase 1) ────────────────────────────────
# Se ejecuta una vez por cliente, desde la CLI. De la calidad de esa pasada
# depende todo lo que ese bot dirá después: aquí compensa el modelo bueno.
# Para probar sin gastar:  npm run admin -- autoconfig <slug> "..." --provider ollama
AUTOCONFIG_PROVIDER=anthropic
AUTOCONFIG_MODEL=claude-opus-5
# El razonamiento y la respuesta comparten este presupuesto. Si se queda corto,
# la salida llega truncada o vacía.
AUTOCONFIG_MAX_TOKENS=8000
AUTOCONFIG_TIMEOUT_MS=180000

# ── Herramientas (fase 3) ─────────────────────────────────────
# Ejecutan peticiones a terceros con parámetros que elige el modelo. Todo
# acotado: destino fijo, sin redirecciones, sin direcciones internas.
TOOL_TIMEOUT_MS=10000
TOOL_MAX_RESPONSE_CHARS=4000

# ── Memoria (fase 4) ──────────────────────────────────────────
# Techo del resumen acumulado por conversación. El presupuesto de contexto va
# por cliente, en bot_configs.context_token_budget.
MEMORY_SUMMARY_MAX_TOKENS=400

# ── Límites ───────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
LLM_TIMEOUT_MS=120000  # Ollama en frío tarda >60s en cargar un modelo de 32B
MAX_MESSAGE_CHARS=4000

# Los tokens de cada cliente (bot de Telegram, número de WhatsApp, página de
# Instagram) NO van aquí: van cifrados en la tabla channel_accounts.
# Enlázalos con:  npm run admin -- link-telegram <slug> <token>

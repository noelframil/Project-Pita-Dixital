{
  "name": "@pita/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "npm run migrate:prod && node dist/index.js",
    "migrate:prod": "node dist/cli/migrate.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "admin": "tsx src/cli/admin.ts",
    "infra:up": "tsx scripts/infra-up.ts",
    "infra:down": "docker compose -f ../../docker-compose.yml down",
    "infra:reset": "docker compose -f ../../docker-compose.yml down -v && npm run infra:up",
    "chat": "tsx scripts/chat-cli.ts",
    "tunnel": "tsx scripts/tunnel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/websocket": "^11.3.0",
    "bullmq": "^6.1.2",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.2.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.9.0",
    "resend": "^6.22.0",
    "stripe": "^22.5.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "localtunnel": "^2.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
